# CashFlow Manager local development environment
# Copy to .env locally. Never commit real secrets.

POSTGRES_DB=cashflow_manager
POSTGRES_USER=cashflow_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

DATABASE_URL=postgresql://cashflow_app:change-me-local-only@postgres:5432/cashflow_manager?schema=public
API_PORT=3000
API_HOST_PORT=3000
FRONTEND_HOST_PORT=8080
NODE_ENV=development
JWT_PRIVATE_KEY="replace-with-local-ed25519-private-key-pem"
JWT_PUBLIC_KEY="replace-with-local-ed25519-public-key-pem"
ACCESS_TOKEN_KID=local-development-key
ACCESS_TOKEN_ISSUER=cashflow-manager-api
ACCESS_TOKEN_AUDIENCE=cashflow-manager-mobile
IAP_VERIFICATION_MODE=disabled
SEPAY_ENABLED=false
SEPAY_WEBHOOK_SECRET=replace-with-local-sepay-webhook-secret
SEPAY_CHECKOUT_BASE_URL=http://localhost:8081/payments/sepay/checkout

N8N_HOST_PORT=5678
N8N_POSTGRES_DB=cashflow_n8n
N8N_POSTGRES_USER=n8n_app
N8N_POSTGRES_PASSWORD=change-me-n8n-local-only
N8N_ENCRYPTION_KEY=replace-with-local-n8n-encryption-key
N8N_CHATBOT_WEBHOOK_URL=http://n8n:5678/webhook/cashflow-ai-analysis
N8N_CHATBOT_WEBHOOK_SECRET=replace-with-local-webhook-hmac-secret
N8N_CHATBOT_ALLOWED_HOSTS=n8n.example.com
N8N_AI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
N8N_AI_API_KEY=replace-with-local-ai-api-key
N8N_AI_MODEL=gpt-4o-mini
