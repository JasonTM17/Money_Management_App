# ────────────────────────────────────────
# CashFlow Manager — Production Env Template
# Replace all values before deploying.
# ────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=cashflow_manager
POSTGRES_USER=cashflow_prod
POSTGRES_PASSWORD=<generate-64-char-random>
POSTGRES_PORT=5433

# API
DATABASE_URL=postgresql://cashflow_prod:<PASSWORD>@postgres:5432/cashflow_manager?schema=public
API_PORT=3000
API_HOST_PORT=3000
NODE_ENV=production

# JWT (Ed25519 key pair)
JWT_PRIVATE_KEY=<ed25519-private-key-base64>
JWT_PUBLIC_KEY=<ed25519-public-key-base64>

# n8n automation (optional)
N8N_POSTGRES_DB=cashflow_n8n
N8N_POSTGRES_USER=n8n_prod
N8N_POSTGRES_PASSWORD=<generate-64-char-random>
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=<generate-64-char-random>
N8N_CHATBOT_WEBHOOK_URL=
N8N_CHATBOT_WEBHOOK_SECRET=<generate-webhook-secret>
N8N_AI_CHAT_COMPLETIONS_URL=
N8N_AI_API_KEY=
N8N_AI_MODEL=

# Frontend
FRONTEND_HOST_PORT=8080
